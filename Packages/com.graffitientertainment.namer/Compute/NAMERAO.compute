// NAMERAO.compute
// GPU image-space AO extraction kernels (Phase 03.1, plan 01).
//
// Five staged kernels estimate ambient occlusion from the base color when no authored
// _OcclusionMap exists (the Tripo case): luminance -> hierarchical block-average ->
// separable gaussian low-pass -> AO remap. The extracted AO is written to the GREEN
// channel (the _AoIn.g contract) and becomes both the CSNormalize un-multiply divisor
// and the packed surface B channel (D-08).
//
// Base color is the only channel that receives sRGB -> linear conversion (mirroring
// CSNormalize). The average reduction is HIERARCHICAL: every output texel is a MEAN in
// [0,1], so it is overflow-free at any resolution and deterministic (no atomic
// accumulation, no fixed-point accumulator).
//
// All write targets are LINEAR. _AoOut is R8G8B8A8_UNorm linear; intermediates are
// R16G16B16A16_SFloat linear. Compute never writes sRGB.

#include "NAMERAO.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"

#pragma kernel CSLuminance
#pragma kernel CSAverage
#pragma kernel CSBlurH
#pragma kernel CSBlurV
#pragma kernel CSAoRemap
#pragma kernel CSJumpFloodInit
#pragma kernel CSJumpFloodStep

// Kernel-written outputs (linear, random-access).
RWTexture2D<float4> _Luma;
RWTexture2D<float4> _BlurA;
RWTexture2D<float4> _BlurB;
RWTexture2D<float4> _AoOut;
RWTexture2D<float4> _AvgA;   // ping-pong downsample-average target
RWTexture2D<float4> _AvgB;   // ping-pong downsample-average target
RWTexture2D<float4> _DstAvg; // generic block-average write target (bound to _AvgA/_AvgB per pass)

// Blit-uploaded inputs (never written by kernels).
Texture2D<float4> _BaseColorIn; // linear/raw base map already uploaded by NamerComputePipeline
Texture2D<float4> _SrcAvg;      // generic block-average read target (bound to _Luma/_AvgA/_AvgB per pass)

// Separable-blur ping-pong source/target (the same kernel body serves both passes).
Texture2D<float4> _Src;       // generic blur read target
RWTexture2D<float4> _Dst;     // generic blur write target

// Jump-flood seam-dilation (Phase 03.1, plan 02). _Seed is the bilinearly-upsampled
// bake (g = AO, a = valid flag); _Jfa/_JfaOut are the ping-pong dilation buffers
// (r = filled flag, g = AO, a = normalized distance to the nearest seed).
Texture2D<float4> _Seed;
RWTexture2D<float4> _Jfa;
RWTexture2D<float4> _JfaOut;

// Uniforms.
uint2 _Size; // unsigned: compared against SV_DispatchThreadID (uint) in the kernel guards
float _SourceIsSrgb;
int _Radius;
float _Sigma;
float _AoStrength;
float _AoContrast;
float _AoDirect;    // 0 = luminance-relative extract remap; 1 = direct green-AO remap (bake)
float _BlurChannel; // 0 = red (luminance low-pass); 1 = green (AO user blur)
float _LumaAverage;
uint2 _AvgSrcSize;
uint2 _AvgDstSize;
int _Step;      // current jump-flood step (halves each pass)
int _MaxDilate; // dilation cap in pixels (16)

[numthreads(8,8,1)]
void CSLuminance(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 baseColorIn = _BaseColorIn[id.xy];
    float3 base = (_SourceIsSrgb > 0.5) ? SRGBToLinear(baseColorIn.rgb) : baseColorIn.rgb;
    float luma = dot(base, float3(NAMER_LUMA_R, NAMER_LUMA_G, NAMER_LUMA_B));
    _Luma[id.xy] = float4(luma, 0.0, 0.0, 1.0);
}

// Hierarchical block-average: each thread writes the MEAN of the 8x8 input block it
// covers. Every output texel is a mean in [0,1], so the reduction is overflow-free at
// any resolution (2K/4K/4096^2). NOT a global accumulation: no atomics, no
// structured-buffer accumulation, no fixed-point accumulator.
[numthreads(8,8,1)]
void CSAverage(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _AvgDstSize.x || id.y >= _AvgDstSize.y)
    {
        return;
    }

    float sum = 0.0;
    float count = 0.0;
    for (uint y = 0; y < 8; ++y)
    {
        for (uint x = 0; x < 8; ++x)
        {
            uint2 src = id.xy * uint2(8u, 8u) + uint2(x, y);
            if (src.x < _AvgSrcSize.x && src.y < _AvgSrcSize.y)
            {
                sum += _SrcAvg[src].r;
                count += 1.0;
            }
        }
    }

    float blockMean = (count > 0.0) ? (sum / count) : 0.0;
    _DstAvg[id.xy] = float4(blockMean, 0.0, 0.0, 1.0);
}

// Separable gaussian low-pass: horizontal pass. Reads 2*radius+1 neighbors, no
// groupshared apron (Metal/D3D11 groupshared budget is not required for correctness).
[numthreads(8,8,1)]
void CSBlurH(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float acc = 0.0;
    float wsum = 0.0;
    for (int x = -_Radius; x <= _Radius; ++x)
    {
        float w = exp(-(float)(x * x) / (2.0 * _Sigma * _Sigma));
        int sx = clamp((int)id.x + x, 0, (int)_Size.x - 1);
        acc += NamerBlurSample(_Src[int2(sx, (int)id.y)], _BlurChannel) * w;
        wsum += w;
    }

    _Dst[id.xy] = NamerBlurWrite(acc / wsum, _BlurChannel);
}

// Separable gaussian low-pass: vertical pass.
[numthreads(8,8,1)]
void CSBlurV(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float acc = 0.0;
    float wsum = 0.0;
    for (int y = -_Radius; y <= _Radius; ++y)
    {
        float w = exp(-(float)(y * y) / (2.0 * _Sigma * _Sigma));
        int sy = clamp((int)id.y + y, 0, (int)_Size.y - 1);
        acc += NamerBlurSample(_Src[int2((int)id.x, sy)], _BlurChannel) * w;
        wsum += w;
    }

    _Dst[id.xy] = NamerBlurWrite(acc / wsum, _BlurChannel);
}

[numthreads(8,8,1)]
void CSAoRemap(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float ao;
    if (_AoDirect > 0.5)
    {
        // Direct mode (geometry bake): the AO already lives in the green channel.
        ao = saturate(_Dst[id.xy].g);
    }
    else
    {
        // Extraction mode: AO = low-frequency luminance normalized by the (hierarchically
        // reduced) mean.
        ao = saturate(_Dst[id.xy].r / max(_LumaAverage, 1e-4));
    }

    ao = NamerAoRemap(ao, _AoStrength, _AoContrast);

    // AO in the GREEN channel — the _AoIn.g contract (Pitfall 1).
    _AoOut[id.xy] = float4(0.0, ao, 0.0, 1.0);
}

// Seeds the jump-flood field from the upsampled bake: covered texels become valid seeds
// (AO in .g, distance 0); empty texels stay unfilled with a white AO fallback so unfilled
// padding reads as "no occlusion" rather than black.
[numthreads(8,8,1)]
void CSJumpFloodInit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 seed = _Seed[id.xy];
    if (seed.a > 0.5)
    {
        _Jfa[id.xy] = float4(1.0, seed.g, 0.0, 0.0);
    }
    else
    {
        _Jfa[id.xy] = float4(0.0, 1.0, 0.0, 1.0);
    }
}

// One jump-flood pass: propagate the nearest valid seed's AO into empty texels within the
// 16 px dilation cap. The step halves each pass (log2(max dimension) passes). Covered
// texels keep their own seed; empty texels adopt the closest filled neighbor's AO.
[numthreads(8,8,1)]
void CSJumpFloodStep(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 self = _Jfa[id.xy];
    float bestDist = self.r > 0.5 ? self.a : 1.0;
    float bestAo = self.g;

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            if (dx == 0 && dy == 0)
            {
                continue;
            }

            int2 p = int2((int)id.x + dx * _Step, (int)id.y + dy * _Step);
            if (p.x < 0 || p.y < 0 || p.x >= (int)_Size.x || p.y >= (int)_Size.y)
            {
                continue;
            }

            float4 n = _Jfa[p];
            if (n.r <= 0.5)
            {
                continue;
            }

            float dist = n.a * (float)_MaxDilate + (float)_Step;
            if (dist > (float)_MaxDilate)
            {
                continue;
            }

            float distNorm = dist / (float)_MaxDilate;
            if (distNorm < bestDist)
            {
                bestDist = distNorm;
                bestAo = n.g;
            }
        }
    }

    _JfaOut[id.xy] = float4(bestDist < 1.0 ? 1.0 : 0.0, bestAo, 0.0, bestDist);
}
