// NAMERDecomp.compute
// GPU vertex-color decomposition + residual kernels (Phase 4, plan 02).
//
// Seven staged kernels turn the already-uploaded linear base color and the quantized
// Color32 vertex colors (plan 04-01) into the multiplicative quotient residual:
//   CSRasterizeVertexColors  -> barycentric texel-space rasterize of quantized colors
//                               (_VcInterp RGB = interp color, A = coverage mask)
//   CSProjectBase            -> projection write-back: covered texels write the rasterized
//                               Gouraud surface (vc.rgb) with source base alpha; uncovered
//                               texels pass the source base through unchanged
//   CSResidual               -> residual = max(base, _VcFloor) / max(vcInterp, _VcFloor)
//                               (uncovered texels take the identity branch, Pitfall 1)
//   CSDespike                -> collapse quotient spikes AND 1-texel spike runs: a
//                               channel whose vcInterp quantized to ZERO (<= _VcFloor)
//                               and which sits above _SpikeFactor x the second-smallest
//                               of its 4 clamp-to-edge neighbors is replaced by that
//                               value (edge texels between black verts divided by
//                               _VcFloor; debug session residual-missing-triangles
//                               edge-line artifact)
//   CSDilateResidual         -> atlas padding: uncovered texels within _DilateRadius
//                               (Chebyshev) of covered texels take their mean residual,
//                               so bilinear sampling at UV island borders never mixes
//                               a real residual with the identity 1.0 (same debug
//                               session, seam-step artifact)
//   CSErrorHeatmap           -> reconstruction error (one consistent MAE) mapped through
//                               the viridis ramp, plus the raw stat textures the reduce
//                               consumes
//   CSReduce                 -> hierarchical 4-channel block reduce (overflow-free, no
//                               atomics): .r = mean error, .g = max error,
//                               .b = mean coverage, .a = min covered base alpha
//
// The residual is the QUOTIENT max(base, _VcFloor) / max(vcInterp, _VcFloor) — NOT a
// subtractive difference — because the runtime shader multiplies
// (albedo = baseResidual * vertexColor, NamerSurface.hlsl). The symmetric floor on BOTH
// operands (04.2 RESEARCH Pattern 2) keeps the quotient exactly 1.0 even for the
// below-floor dark-texel class (Color32 channels quantized to 0): with base == vc under
// the projection, max(base, F) == max(vc, F) and the divide is the IEEE x/x identity. It
// is derived from the QUANTIZED Color32 (what the runtime actually interpolates), never
// the float fit (Pitfall 2).
//
// CSProjectBase is the projection write-back of the 04.2 by-construction collapse: it
// writes the SAME rasterization the residual kernel reads as its divisor, so the quotient
// becomes an IEEE x/x identity (base == vcInterp bit-for-bit) rather than an approximation
// quality. The R16G16B16A16_SFloat write target keeps the projected base out of an 8-bit
// intermediate, which would reintroduce up to ~10% quotient deviation on dark VCs
// (RESEARCH Pattern 1 constraint 1).
//
// All write targets are LINEAR. _VcInterp/_ErrorHeatmap are R8G8B8A8_UNorm linear;
// _ResidualOut/_ProjectedOut/_ErrorStat are R16G16B16A16_SFloat linear. Compute never
// writes sRGB.

#include "NAMERDecomp.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"

#pragma kernel CSRasterizeVertexColors
#pragma kernel CSProjectBase
#pragma kernel CSResidual
#pragma kernel CSDespike
#pragma kernel CSDilateResidual
#pragma kernel CSErrorHeatmap
#pragma kernel CSReduce

// Barycentric epsilons (mirror NamerAOBaker.TryReconstruct / VertexColorFitter). The
// area epsilon is compared against denom = (2*Area)^2 in TEXEL units — see the
// texel-space test in CSRasterizeVertexColors.
static const float NAMER_DECOMP_AREA_EPS = 1e-8;
static const float NAMER_DECOMP_INSIDE_EPS = 1e-4;

// Kernel-written outputs (linear, random-access).
RWTexture2D<float4> _VcInterp;      // R8G8B8A8_UNorm linear; rgb = interp color, a = coverage
RWTexture2D<float4> _ResidualOut;   // R16G16B16A16_SFloat linear (quotient residual)
RWTexture2D<float4> _ProjectedOut;  // R16G16B16A16_SFloat linear (projected Gouraud base write-back)
RWTexture2D<float4> _ErrorHeatmap;  // R8G8B8A8_UNorm viridis ramp
RWTexture2D<float4> _ErrorStat;     // R16G16B16A16_SFloat: r=err, g=err, b=coverage, a=minAlpha
RWTexture2D<float4> _CoverageStat;  // R8G8B8A8_UNorm: r = within-threshold flag (0/1)
RWTexture2D<float4> _AvgA;          // reduce ping-pong target
RWTexture2D<float4> _AvgB;          // reduce ping-pong target
RWTexture2D<float4> _DstAvg;        // generic reduce write target (bound to _AvgA/_AvgB per pass)

// Blit-uploaded / kernel-read inputs.
Texture2D<float4> _BaseLinear;      // normalized linear base map (already uploaded)
Texture2D<float4> _SrcAvg;          // generic reduce read target (bound to _ErrorStat/_AvgA/_AvgB/_CoverageStat)
Texture2D<float4> _ResidualSrc;     // despike read source (bound to the fresh CSResidual output)

// Split-mesh vertex data (plan 04-01): UV-space only; _Verts is carried for the
// documented interface but the rasterize is position-independent (like the fitter).
StructuredBuffer<float3> _Verts;
StructuredBuffer<float2> _Uvs;
StructuredBuffer<int3> _Tris;
StructuredBuffer<float4> _Colors;   // quantized Color32 as float4 (RGB = color, A = fit quality)

// Uniforms.
uint2 _Size;              // unsigned: compared against SV_DispatchThreadID (uint)
float _VcFloor;           // divisor floor (mirrors NamerConstants.VcFloor, Pitfall 1)
float _SpikeFactor;       // despike limit factor (mirrors NamerConstants.ResidualSpikeFactor)
int _DilateRadius;        // residual dilation radius in texels (mirrors NamerConstants.ResidualDilateRadius)
float _Threshold;         // error threshold for coverage + residual-required gate
float _MaxObservedErr;    // heatmap normalization bound (>= threshold, ramp scale)
float _FitOnly;           // 1 = residual is identity (fit-only error), 0 = full residual error
uint _TriCount;
uint2 _AvgSrcSize;
uint2 _AvgDstSize;

// Rasterize the quantized Color32 colors into UV space. One thread per texel walks every
// triangle, runs a barycentric point-in-triangle test (the exact math of
// NamerAOBaker.RayTriangleJob.TryReconstruct with the same epsilons), interpolates the
// quantized colors, and writes (interpColor, 1). Uncovered texels stay (0,0,0,0) — the
// alpha-0 coverage mask (Pitfall 1 / T-04-05).
[numthreads(8,8,1)]
void CSRasterizeVertexColors(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    // Texel-space barycentric test: denom = (2*Area_texels)^2, so NAMER_DECOMP_AREA_EPS
    // rejects only true zero-area triangles at ANY atlas resolution. In [0,1] UV space
    // denom shrinks quadratically with resolution — at 2048^2 the 1e-8 gate silently
    // discarded ~92% of real triangles (debug: residual-missing-triangles).
    float2 p = float2(id.xy) + 0.5;
    float2 texels = float2(_Size);
    for (uint t = 0; t < _TriCount; ++t)
    {
        int3 tri = _Tris[t];
        float2 a = _Uvs[tri.x] * texels;
        float2 b = _Uvs[tri.y] * texels;
        float2 c = _Uvs[tri.z] * texels;

        float2 v0 = b - a;
        float2 v1 = c - a;
        float2 v2 = p - a;
        float d00 = dot(v0, v0);
        float d01 = dot(v0, v1);
        float d11 = dot(v1, v1);
        float d20 = dot(v2, v0);
        float d21 = dot(v2, v1);
        float denom = d00 * d11 - d01 * d01;
        if (abs(denom) < NAMER_DECOMP_AREA_EPS)
        {
            continue;
        }

        float v = (d11 * d20 - d01 * d21) / denom;
        float w = (d00 * d21 - d01 * d20) / denom;
        float u = 1.0 - v - w;
        if (u < -NAMER_DECOMP_INSIDE_EPS || v < -NAMER_DECOMP_INSIDE_EPS || w < -NAMER_DECOMP_INSIDE_EPS)
        {
            continue;
        }

        float3 color = _Colors[tri.x].rgb * u + _Colors[tri.y].rgb * v + _Colors[tri.z].rgb * w;
        _VcInterp[id.xy] = float4(color, 1.0);
        return;
    }

    _VcInterp[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
}

// Multiplicative quotient residual (Pitfall 1 floor guard). Uncovered texels take the
// identity residual (1,1,1, baseAlpha) so no divide runs on empty texels and the base
// alpha is preserved (Pitfall 5). Covered texels divide the floored dividend by the
// floored vcInterp: max(base, _VcFloor) / max(vcInterp, _VcFloor). The symmetric floor
// (04.2 RESEARCH Pattern 2) removes the below-floor dark-texel exception class: when
// base == vcInterp (the projection), the quotient is exactly 1.0 everywhere, including
// channels that Color32 quantization drove to 0.
[numthreads(8,8,1)]
void CSResidual(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 vc = _VcInterp[id.xy];
    float baseA = _BaseLinear[id.xy].a;
    if (vc.a < 0.5)
    {
        _ResidualOut[id.xy] = float4(1.0, 1.0, 1.0, baseA);
        return;
    }

    float3 b = max(_BaseLinear[id.xy].rgb, _VcFloor.xxx);
    float3 v = max(vc.rgb, _VcFloor.xxx);
    _ResidualOut[id.xy] = float4(b / v, baseA);
}

// Despike pass (debug session residual-missing-triangles, edge-line artifact). Texel
// centers on an edge between near-black vertices interpolate vcInterp to EXACTLY 0
// (quantized zero — bary = 0 between two black verts) — and since _VcFloor (1e-3) sits
// below one 8-bit step (1/255), max(vc, F) never bounds the divide, leaving quotient
// spikes of base/_VcFloor (~450x on the real asset). The runtime material samples the
// residual bilinearly, smearing each spike into a bright hue-tinted line along the edge.
// A channel is a spike candidate ONLY when its interpolated vc quantized to zero
// (vc <= _VcFloor): the legitimate low-vc band carries vc >= 1/255 and its quotient is
// meaningful — collapsing it toward the identity would paint a DARK line (vc * 1.0),
// and the identity uncovered neighbors at a coverage border would otherwise fake a
// small second-smallest reference. Among candidates, a channel exceeding _SpikeFactor
// times the SECOND-SMALLEST of its 4 clamp-to-edge neighbors is replaced by that value.
// The reference is the second-smallest, not the median of 4, because the median is
// blind to 1-texel-wide spike RUNS: a collinear spiky neighbor pulls the median up to
// ~half the spike, so limit ~ 2x spike > spike and the run survives (measured on the
// real asset: 2-texel 6.6x/10.7x pairs after the median pass). The second-smallest can
// be inflated by at most one spiky neighbor, so runs trip too. Per-channel, alpha passes
// through. Read source / write dest — never in place — so neighbors are always the
// pre-despike values (no cascade).
// Second-smallest of 4 via a 5-compare-exchange sorting network, component-wise:
// sort (a,b), (c,d), then (a,c), (b,d), then (b,c) — leaving a<=b<=c<=d; return b.
float3 SecondSmallest4(float3 a, float3 b, float3 c, float3 d)
{
    float3 t;
    t = min(a, b); b = max(a, b); a = t;
    t = min(c, d); d = max(c, d); c = t;
    t = min(a, c); c = max(a, c); a = t;
    t = min(b, d); d = max(b, d); b = t;
    t = min(b, c); c = max(b, c); b = t;
    return b;
}

[numthreads(8,8,1)]
void CSDespike(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    // Clamp-to-edge neighbors (border texels reuse themselves, mirroring the residual
    // texture's clamp wrap mode at runtime).
    uint2 xm = uint2(id.x == 0 ? 0u : id.x - 1u, id.y);
    uint2 xp = uint2(id.x + 1u >= _Size.x ? _Size.x - 1u : id.x + 1u, id.y);
    uint2 ym = uint2(id.x, id.y == 0 ? 0u : id.y - 1u);
    uint2 yp = uint2(id.x, id.y + 1u >= _Size.y ? _Size.y - 1u : id.y + 1u);

    float4 self = _ResidualSrc[id.xy];
    float3 vc = _VcInterp[id.xy].rgb;
    float3 reference = SecondSmallest4(_ResidualSrc[xm].rgb, _ResidualSrc[xp].rgb, _ResidualSrc[ym].rgb, _ResidualSrc[yp].rgb);
    float3 limit = _SpikeFactor * reference;
    float3 rgb = float3(self.r > limit.r && vc.r <= _VcFloor ? reference.r : self.r,
                        self.g > limit.g && vc.g <= _VcFloor ? reference.g : self.g,
                        self.b > limit.b && vc.b <= _VcFloor ? reference.b : self.b);
    _ResidualOut[id.xy] = float4(rgb, self.a);
}

// Residual dilation (debug session residual-missing-triangles, seam-step artifact).
// Uncovered atlas texels carry the identity residual 1.0; at UV island borders the
// runtime's BILINEAR residual sample mixes the correct covered residual with that
// identity (measured 0.21 next to 1.0 across a seam -> after = vc * ~1.0 >> base, a
// 1px orange line; a despike cannot fix a step by principle). Standard atlas padding:
// push the covered residual outward. An uncovered texel (vc.a < 0.5) takes the mean
// residual of covered texels within a Chebyshev radius of _DilateRadius — single pass
// over the STATIC coverage mask, no iterative propagation; covered texels and
// uncovered texels with no covered neighbor in range pass through unchanged.
[numthreads(8,8,1)]
void CSDilateResidual(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    if (_VcInterp[id.xy].a >= 0.5)
    {
        _ResidualOut[id.xy] = _ResidualSrc[id.xy];
        return;
    }

    float3 sum = float3(0.0, 0.0, 0.0);
    float count = 0.0;
    int sizeX = (int)_Size.x;
    int sizeY = (int)_Size.y;
    for (int dy = -_DilateRadius; dy <= _DilateRadius; dy++)
    {
        for (int dx = -_DilateRadius; dx <= _DilateRadius; dx++)
        {
            int2 p = int2(id.xy) + int2(dx, dy);
            if (p.x < 0 || p.y < 0 || p.x >= sizeX || p.y >= sizeY)
            {
                continue;
            }

            if (_VcInterp[p].a >= 0.5)
            {
                sum += _ResidualSrc[p].rgb;
                count += 1.0;
            }
        }
    }

    float4 src = _ResidualSrc[id.xy];
    _ResidualOut[id.xy] = (count > 0.0) ? float4(sum / count, src.a) : src;
}

// Projection write-back (04.2 by-construction collapse). Writes the rasterized Gouraud
// surface back as the cleaned base: covered texels write the projected RGB from the
// rasterization (the exact divisor CSResidual recomputes) but take the SOURCE base alpha
// so coverage-in-alpha never leaks into the cleaned base (RESEARCH Pitfall 2). Uncovered
// texels (vc.a < 0.5) pass the source base through unchanged (RGB and alpha).
[numthreads(8,8,1)]
void CSProjectBase(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 vc = _VcInterp[id.xy];
    if (vc.a < 0.5)
    {
        _ProjectedOut[id.xy] = _BaseLinear[id.xy];
        return;
    }

    _ProjectedOut[id.xy] = float4(vc.rgb, _BaseLinear[id.xy].a);
}

// Reconstruction error (one consistent mean-channel MAE) + viridis heatmap + the raw stat
// textures consumed by CSReduce. rec = vcInterp * residual (fit-only: residual == 1). The
// heatmap is normalized by a fixed _MaxObservedErr bound (>= threshold) so the ramp is
// well-scaled; uncovered texels write the low violet anchor (D-11).
[numthreads(8,8,1)]
void CSErrorHeatmap(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 vc = _VcInterp[id.xy];
    float baseA = _BaseLinear[id.xy].a;
    if (vc.a < 0.5)
    {
        _ErrorHeatmap[id.xy] = float4(NAMER_DECOMP_HEATMAP(0.0), 1.0);
        _ErrorStat[id.xy] = float4(0.0, 0.0, 0.0, 1.0);
        _CoverageStat[id.xy] = float4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    float3 b = _BaseLinear[id.xy].rgb;
    float3 rec = (_FitOnly > 0.5) ? vc.rgb : (vc.rgb * _ResidualOut[id.xy].rgb);
    float err = (abs(rec.r - b.r) + abs(rec.g - b.g) + abs(rec.b - b.b)) / 3.0;
    float within = (err <= _Threshold) ? 1.0 : 0.0;

    _ErrorHeatmap[id.xy] = float4(NAMER_DECOMP_HEATMAP(err / max(_MaxObservedErr, 1e-6)), 1.0);
    _ErrorStat[id.xy] = float4(err, err, 1.0, baseA);
    _CoverageStat[id.xy] = float4(within, 0.0, 0.0, 1.0);
}

// Hierarchical 4-channel block reduce (the CSAverage SHAPE — overflow-free, no atomics,
// no structured-buffer accumulation). Each channel carries its own reduction: .r = mean
// (error), .g = max (error), .b = mean (coverage flag), .a = min (covered base alpha).
// Every output texel stays in [0,1], so the reduction is overflow-free at any resolution
// and the CPU reads all stats from a single tiny RT.
[numthreads(8,8,1)]
void CSReduce(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _AvgDstSize.x || id.y >= _AvgDstSize.y)
    {
        return;
    }

    float sumR = 0.0;
    float maxG = 0.0;
    float sumB = 0.0;
    float minA = 1.0;
    float count = 0.0;

    for (uint y = 0; y < 8; ++y)
    {
        for (uint x = 0; x < 8; ++x)
        {
            uint2 src = id.xy * uint2(8u, 8u) + uint2(x, y);
            if (src.x < _AvgSrcSize.x && src.y < _AvgSrcSize.y)
            {
                float4 s = _SrcAvg[src];
                sumR += s.r;
                maxG = max(maxG, s.g);
                sumB += s.b;
                minA = min(minA, s.a);
                count += 1.0;
            }
        }
    }

    _DstAvg[id.xy] = float4(
        count > 0.0 ? sumR / count : 0.0,
        maxG,
        count > 0.0 ? sumB / count : 0.0,
        minA);
}
