// NAMERPack.compute
// GPU surface-packing kernels (Phase 2, plan 02-02).
//
// Three staged kernels mirror Core/NamerFormat line-for-line through the shared
// NamerEncode.hlsl include. Roughness = 1 - smoothness is computed in CSNormalize
// (before quantization); quantization happens inside NamerPackAlphaBits via
// NamerPackSurfaceFromOct in CSSurfacePack.
//
// Base color is the only channel that receives sRGB -> linear conversion.
// Normal / AO / metallic / roughness are never color-converted.
//
// All write targets are LINEAR (D-11). _SurfaceOut is R8G8B8A8_UNorm linear;
// intermediates are R16G16B16A16_SFloat linear. Compute never writes sRGB.

#include "NamerEncode.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"

#pragma kernel CSNormalize
#pragma kernel CSOctahedralEncode
#pragma kernel CSSurfacePack

// Kernel-written outputs (linear, random-access).
RWTexture2D<float4> _BaseColorOut;
RWTexture2D<float4> _Octahedral;
RWTexture2D<float4> _PackInputs;
RWTexture2D<float4> _SurfaceOut;

// Blit-uploaded inputs (never written by kernels).
Texture2D<float4> _BaseColorIn;      // base map or white fill
Texture2D<float4> _NormalTexel;      // Unity normal texel (raw RGB or DXT5nm/AG swizzle) or neutral (0.5,0.5,1.0)
Texture2D<float4> _AoIn;             // AO map or white fill
Texture2D<float4> _MetallicGlossIn;  // metallic/gloss map or neutral fill

// Uniforms.
float _SourceIsSrgb;
float _AoUnmultiplyStrength;
float _AoUnmultiplyFloor;
float _Metallic;
float _SmoothnessScalar;
float _Roughness;
float _Emissive;
float _SmoothnessTextureChannel;
float _HasMetallicGlossMap;
uint2 _Size; // unsigned: compared against SV_DispatchThreadID (uint) in the kernel guards

[numthreads(8,8,1)]
void CSNormalize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float4 baseColorIn = _BaseColorIn[id.xy];
    float3 base = (_SourceIsSrgb > 0.5) ? SRGBToLinear(baseColorIn.rgb) : baseColorIn.rgb;
    float ao = _AoIn[id.xy].g;
    _BaseColorOut[id.xy] = float4(base / lerp(1.0, max(ao, _AoUnmultiplyFloor), _AoUnmultiplyStrength), 1.0);

    float metallic;
    float roughness;
    if (_HasMetallicGlossMap > 0.5)
    {
        float4 metallicGloss = _MetallicGlossIn[id.xy];
        metallic = metallicGloss.r;
        float smoothnessSource = (_SmoothnessTextureChannel == 1.0) ? baseColorIn.a : metallicGloss.a;
        float smoothness = smoothnessSource * _SmoothnessScalar;
        roughness = 1.0 - smoothness;
    }
    else
    {
        metallic = _Metallic;
        roughness = _Roughness;
    }

    _PackInputs[id.xy] = float4(metallic, roughness, _Emissive, 1.0);
}

[numthreads(8,8,1)]
void CSOctahedralEncode(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    // Unity delivers imported normal maps either raw RGB (X in R, A = 1) or in the
    // DXT5nm/AG swizzle its NormalMap importer applies (X in A, R white, B
    // unreliable); x *= w selects X in both layouts (UnpackNormalmapRGorAG's
    // trick). Z is rebuilt from the signed XY so the Blender-mirrored encode
    // receives the authored raw DirectX texel it is defined over.
    float4 texel = _NormalTexel[id.xy];
    texel.x *= texel.w;
    float2 signedXY = texel.xy * 2.0 - 1.0;
    texel.z = sqrt(1.0 - saturate(dot(signedXY, signedXY))) * 0.5 + 0.5;

    float2 oct = NamerOctahedralEncode(texel.xyz);
    _Octahedral[id.xy] = float4(oct, _AoIn[id.xy].g, 0.0);
}

[numthreads(8,8,1)]
void CSSurfacePack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float2 oct = _Octahedral[id.xy].rg;
    float ao = _Octahedral[id.xy].b;
    float metallic = _PackInputs[id.xy].x;
    float roughness = _PackInputs[id.xy].y;
    float emissive = _PackInputs[id.xy].z;
    _SurfaceOut[id.xy] = NamerPackSurfaceFromOct(oct, ao, metallic, emissive, roughness);
}
