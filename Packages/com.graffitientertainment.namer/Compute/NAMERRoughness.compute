// NAMERRoughness.compute
// GPU image-space roughness extraction kernels (Phase 04.1, plan 01).
//
// Three staged kernels turn the already-cleaned linear base color (_BaseColorOut from
// CSNormalize) into a per-texel roughness texture for the Sobel (Blender-parity)
// estimator: CSRoughnessSobel -> hierarchical max-reduce -> CSRoughnessNormalize.
//
// CSRoughnessSobel computes the Rec.601 luminance of the cleaned base (NAMERRoughness.hlsl,
// deliberately NOT the Rec.709 NAMER_LUMA_* — RESEARCH Pitfall 4), then the 3x3 Sobel edge
// magnitude sqrt(gx*gx + gy*gy), written to the GREEN channel of _RoughnessRaw (the
// `.g = max` contract shared with CSReduce).
//
// CSRoughnessMaxReduce reuses the CSReduce `.g = max` hierarchical body (overflow-free 8x8
// block max, no atomics) to reduce the Sobel magnitude to a tiny RT, so the GLOBAL max is
// available for Blender's np.max normalization (RESEARCH Pitfall 3).
//
// CSRoughnessNormalize emits the final roughness directly in the roughness domain:
// saturate(mag / max(globalMax, 1e-4)) — NO 1 - x inversion (RESEARCH Pitfall 1).
//
// All write targets are LINEAR. _RoughnessOut is R8G8B8A8_UNorm linear; intermediates are
// R16G16B16A16_SFloat linear. Compute never writes sRGB.

#include "NAMERRoughness.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"

#pragma kernel CSRoughnessSobel
#pragma kernel CSRoughnessMaxReduce
#pragma kernel CSRoughnessNormalize

// Kernel-written outputs (linear, random-access).
RWTexture2D<float4> _RoughnessRaw; // R16G16B16A16_SFloat: g = Sobel edge magnitude
RWTexture2D<float4> _RoughnessOut; // R8G8B8A8_UNorm linear: r = normalized roughness
RWTexture2D<float4> _DstAvg;       // generic max-reduce write target

// Blit-uploaded / kernel-read inputs.
Texture2D<float4> _BaseColorOut; // the already-linear cleaned base (CSNormalize output)
Texture2D<float4> _SrcAvg;       // generic max-reduce read target

// Uniforms.
uint2 _Size;       // unsigned: compared against SV_DispatchThreadID (uint) in the kernel guards
uint2 _AvgSrcSize;
uint2 _AvgDstSize;
float _GlobalMax;  // reduced global Sobel max (uploaded back for the normalize pass)

// Clamped luminance tap into the cleaned base (edge clamp mirrors CSBlurH/CSBlurV, T-04.1-01).
float SampleLuma(uint3 id, int dx, int dy)
{
    int2 p = int2(clamp((int)id.x + dx, 0, (int)_Size.x - 1),
                  clamp((int)id.y + dy, 0, (int)_Size.y - 1));
    return NamerRoughnessLuminance(_BaseColorOut[p].rgb);
}

// 3x3 Sobel on the cleaned-base luminance; magnitude -> _RoughnessRaw.g (Blender parity).
[numthreads(8,8,1)]
void CSRoughnessSobel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    float l00 = SampleLuma(id, -1, -1);
    float l01 = SampleLuma(id,  0, -1);
    float l02 = SampleLuma(id,  1, -1);
    float l10 = SampleLuma(id, -1,  0);
    float l11 = SampleLuma(id,  0,  0);
    float l12 = SampleLuma(id,  1,  0);
    float l20 = SampleLuma(id, -1,  1);
    float l21 = SampleLuma(id,  0,  1);
    float l22 = SampleLuma(id,  1,  1);

    // Gx (horizontal edges): [-1 0 1; -2 0 2; -1 0 1]
    float gx = -l00 + l02 - 2.0 * l10 + 2.0 * l12 - l20 + l22;
    // Gy (vertical edges):   [-1 -2 -1; 0 0 0; 1 2 1]
    float gy = -l00 - 2.0 * l01 - l02 + l20 + 2.0 * l21 + l22;

    _RoughnessRaw[id.xy] = float4(0.0, sqrt(gx * gx + gy * gy), 0.0, 1.0);
}

// Hierarchical 8x8 block-max reduce over the Sobel magnitude (.g). Copy of the CSReduce
// `.g = max` body (NAMERDecomp.compute) — overflow-free, no atomics. Reduces the global
// Sobel max to a tiny RT for Blender's np.max normalization (RESEARCH Pitfall 3).
[numthreads(8,8,1)]
void CSRoughnessMaxReduce(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _AvgDstSize.x || id.y >= _AvgDstSize.y)
    {
        return;
    }

    float maxG = 0.0;
    for (uint y = 0; y < 8; ++y)
    {
        for (uint x = 0; x < 8; ++x)
        {
            uint2 src = id.xy * uint2(8u, 8u) + uint2(x, y);
            if (src.x < _AvgSrcSize.x && src.y < _AvgSrcSize.y)
            {
                maxG = max(maxG, _SrcAvg[src].g);
            }
        }
    }

    _DstAvg[id.xy] = float4(0.0, maxG, 0.0, 1.0);
}

// Final normalization: roughness = saturate(mag / globalMax). Emits roughness directly in
// the roughness domain (NO 1 - x inversion, RESEARCH Pitfall 1). Blender:
// np.clip(edge / np.max(edge), 0, 1).
[numthreads(8,8,1)]
void CSRoughnessNormalize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y)
    {
        return;
    }

    _RoughnessOut[id.xy] = float4(saturate(_RoughnessRaw[id.xy].g / max(_GlobalMax, 1e-4)), 0.0, 0.0, 1.0);
}
